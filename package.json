{
  "name": "uiux-warmup",
  "version": "1.0.0",
  "private": true,
  "description": "Web game khởi động cho học viên UI/UX: vào phòng bằng QR, chơi cá nhân hoặc theo team, xếp hạng trực tiếp. UI dựng bằng Zen DS.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "emoji": "node scripts/emoji-assets.mjs",
    "zen:check": "zen-usage --css",
    "test": "node --test \"tests/*.test.js\"",
    "check": "npm run typecheck && npm run zen:check && npm test"
  },
  "dependencies": {
    "@zen-ds/react": "^0.3.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
